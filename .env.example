# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://fitnxt:fitnxt_dev_password@localhost:5432/fitnxt_dev

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_random_secret
JWT_REFRESH_SECRET=replace_with_different_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Resend (transactional email — password reset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@fitnxt.app

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-replace_with_real_key

# AWS S3 (media uploads)
AWS_BUCKET_NAME=fitnxt-media-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
